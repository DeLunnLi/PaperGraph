# PaperGraph Docker 部署环境变量
# 复制此文件为 .env,填入你的配置,然后 docker compose up -d --build

# ── LLM API (必填) ──
# 支持任何 OpenAI 兼容接口: Friday / DeepSeek / OpenAI / 通义千问 / AIHubMix 等
# Friday GLM-5: API Key 填个人 APP ID，Base URL 使用 https://aigc.sankuai.com/v1/openai/native
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat
LLM_DISABLE_THINKING=1

# 可选：Friday 嵌入模型用于搜索语义粗排，失败时自动回退词法评分
EMBED_API_KEY=your-friday-app-id
EMBED_BASE_URL=https://aigc.sankuai.com/v1/openai/native
EMBED_MODEL_NAME=Qwen3-Embedding-0dot6B
EMBED_TIMEOUT_SEC=8

# 可选：扫描版 PDF OCR。设为 friday 后使用 LongCat-VL，失败自动回退本地 OCR。
PAPERGRAPH_OCR_PROVIDER=
PAPERGRAPH_OCR_API_KEY=
PAPERGRAPH_OCR_MODEL=LongCat-VL-8B
PAPERGRAPH_OCR_ENDPOINT=https://aigc.sankuai.com/v1/openai/native/chat/completions
PAPERGRAPH_OCR_TIMEOUT_SEC=60
PAPERGRAPH_OCR_MAX_PAGES=30
PAPERGRAPH_OCR_CONCURRENCY=2
PAPERGRAPH_OCR_DPI=180
PAPERGRAPH_OCR_MAX_IMAGE_BYTES=4500000
PAPERGRAPH_OCR_MAX_TOKENS=4096

# 如果代理导致 SSL/EOF 错误,设为 1
LLM_DISABLE_PROXY=1

# ── 可选: Embedding (用于记忆向量化,不填也能用) ──
# EMBED_MODEL_TYPE=dashscope
# EMBED_MODEL_NAME=text-embedding-v4
# EMBED_API_KEY=your-embed-key
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 可选: 学术搜索 API ──
NCBI_EMAIL=
NCBI_API_KEY=
OPENALEX_MAILTO=

# ── 可选: Tavily 预搜索 ──
TAVILY_PRESEARCH_ENABLED=false
TAVILY_API_KEY=

# ── JWT 密钥（必填，至少 32 字符；请使用密码管理器生成随机值）──
PAPERGRAPH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# ── 应用配置 ──
APP_NAME=PaperGraph
DEBUG=false
LOG_LEVEL=INFO
